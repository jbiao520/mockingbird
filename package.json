{
  "name": "mockingbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Java API workflow and mock workbench",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "icons": "electron scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:runtime": "tsx scripts/verify-runtime.ts",
    "test:agent": "tsx scripts/verify-agents.ts --generate",
    "test:grok": "tsx scripts/verify-agents.ts --grok --generate",
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.0",
    "express": "^5.1.0",
    "java-parser": "^3.0.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "dompurify": "^3.4.16"
  },
  "build": {
    "appId": "dev.mockingbird.desktop",
    "productName": "Mockingbird",
    "icon": "public/icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*",
          "!**/target/**",
          "!**/.mockingbird/**"
        ]
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  }
}
